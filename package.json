{
  "name": "software-factory",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "probes": "node scripts/probes.mjs",
    "test:changed": "vitest run --changed origin/main",
    "test:unit": "vitest run --project unit",
    "test:heavy": "vitest run --project heavy",
    "test:web": "vitest run --project web",
    "check": "node scripts/check.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm clean && tsc -b && pnpm --filter @forge/web build",
    "start": "node apps/server/dist/main.js",
    "serve": "tsc -b && pnpm --filter @forge/web build && node apps/server/dist/main.js",
    "dev:web": "pnpm --filter @forge/web dev",
    "open": "node apps/cli/dist/main.js open",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
