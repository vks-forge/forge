# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# factory runtime data: runs, per-run settings, secrets, sqlite
.forge/data/
.forge/memory/*/.index/

# per-ticket worktrees live inside the repo folder (d-0039)
.worktrees/

# hyperresearch: raw fetched pages and local db are not source
.hyperresearch/
research/raw/
research/temp/
research/index/

# toolchain
node_modules/
dist/
coverage/
*.tmp
*.log

# secrets and local-only settings
.env*
!.env.example
*.pem
*.key
.claude/settings.local.json

# stray temp files written at repo root by a tool (name starts with a drive letter and a
# non-ASCII colon, e.g. "C<colon>Users...AppData...")
/[A-Z]*Users*AppData*
