# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# legacy local runtime data and live-probe artefacts (the data home is outside the repo since B1)
.forge/data/
.forge/memory/*/.index/

# legacy worktrees from before they moved to the data home (d-0098)
.worktrees/

# hyperresearch: raw fetched pages and local db are not source
.hyperresearch/
research/raw/
research/temp/
research/index/

# toolchain
node_modules/
dist/
coverage/
*.tmp
*.log

# secrets and local-only settings
.env*
!.env.example
*.pem
*.key
.claude/settings.local.json

# stray temp files written at repo root by a tool (name starts with a drive letter and a
# non-ASCII colon, e.g. "C<colon>Users...AppData...")
/[A-Z]*Users*AppData*

# agent worktrees (isolated builder runs)
.claude/worktrees/
