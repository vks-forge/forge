{
  "name": "@forge/drivers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    },
    "#tests/*": "./__tests__/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/sdk": "1.8.0",
    "@forge/core": "workspace:*",
    "@forge/tools": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5"
  },
  "bin": {
    "forge-hook": "./bin/hook.js"
  }
}
