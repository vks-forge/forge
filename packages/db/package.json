{
  "name": "@forge/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    },
    "#tests/*": "./__tests__/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@forge/core": "workspace:*",
    "@forge/tools": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
